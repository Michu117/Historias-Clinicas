    Component(chartRango, "ChartConsultasRango", "UI Component", "Chart de consultas por rango")
    Component(chartGenero, "ChartConsultasGenero", "UI Component", "Chart por género")
    Component(chartFecha, "ChartConsultasFecha", "UI Component", "Chart por fecha")
    Component(chartBrush, "ChartBrushNavigator", "UI Component", "Navegador brush de charts")
    Component(dataTable, "DataTable", "UI Component", "Tabla de datos genérica")
    Component(reportDataTable, "ReportDataTable", "UI Component", "Tabla de reportes")
    Component(exportBtn, "ExportButton", "UI Component", "Botón de exportación")
    Component(exportBtnGroup, "ExportButtonGroup", "UI Component", "Grupo de botones de exportación")
    Component(loadingState, "LoadingState", "UI Component", "Estado de carga")
    Component(errorState, "ErrorState", "UI Component", "Estado de error")
    Component(auditInfo, "AuditInfo", "UI Component", "Información de auditoría")

    Component(useReportesDash, "useReportesDashboard", "Hook", "Estado del dashboard de reportes")
    Component(useReportesGrales, "useReportesGenerales", "Hook", "Datos de reportes generales")
    Component(useReportesGenero, "useReportesGenero", "Hook", "Datos por género")
    Component(useReportesRango, "useReportesRango", "Hook", "Datos por rango")
    Component(useReportesServicio, "useReportesServicio", "Hook", "Datos por servicio")
    Component(useRolePerms, "useRolePermissions", "Hook", "Permisos del usuario en reportes")
    Component(useTimePeriod, "useTimePeriodValidation", "Hook", "Validación de períodos")
    Component(useMemoChart, "useMemoizedChartData", "Hook", "Datos memoizados para charts")

