' --- COMPONENT BOUNDARY: Notificaciones ---
Container_Boundary(notif_c, "Módulo Notificaciones") {
    Component(notifBadge, "NotificationBadge", "UI Component", "Badge de notificaciones no leídas")
    Component(notifCard, "NotificationCard", "UI Component", "Card de notificación individual")
}

